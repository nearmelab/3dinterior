{
   "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "calcatom-nearmelab-digital",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
